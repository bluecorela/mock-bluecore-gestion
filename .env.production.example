NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://portal.bluecore.example
SWAGGER_ENABLED=false

SUPABASE_URL=https://production-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-secret
SUPABASE_ANON_KEY=replace-with-production-anon-key
SUPABASE_V2_SCHEMA=bluecore_v2

AUTH_EMAIL_PROVIDER=supabase
FRONTEND_URL=https://portal.bluecore.example

# Secreto HMAC de al menos 32 caracteres; obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOAD_CONFIRMATION_SECRET=

# URL pública de la API para el recurso MCP (sin /api)
PUBLIC_API_URL=https://bluecore-gestion-api.bluecorela.com
