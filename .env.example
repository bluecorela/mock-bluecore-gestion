# Runtime
NODE_ENV=production
PORT=3000
API_PORT=3000
CORS_ORIGINS=https://your-frontend.example.com
SWAGGER_ENABLED=false

# Supabase backend credentials. Never expose the service-role key to the front.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-cloud-secret
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_V2_SCHEMA=bluecore_v2

# Authentication email flow
AUTH_EMAIL_PROVIDER=supabase
FRONTEND_URL=https://your-frontend.example.com
