NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true

SUPABASE_URL=https://development-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-development-secret
SUPABASE_ANON_KEY=replace-with-development-anon-key
SUPABASE_V2_SCHEMA=bluecore_v2

AUTH_EMAIL_PROVIDER=supabase
FRONTEND_URL=http://localhost:4200

# Secreto HMAC de al menos 32 caracteres; obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOAD_CONFIRMATION_SECRET=

# URL pública de la API para el recurso MCP (sin /api)
PUBLIC_API_URL=http://localhost:3000
